# Zoria Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================
DB_NAME=zoria
DB_USER=zoria
DB_PASSWORD=zoria_password
DB_PORT=5432
DB_HOST=postgres

# PostgreSQL connection string (alternative to individual vars above)
# DATABASE_URL=postgresql://zoria:zoria_password@postgres:5432/zoria

# ============================================
# Backend Configuration
# ============================================
# OpenAI API Key (required for document processing)
OPENAI_API_KEY=your-openai-api-key-here

# JWT Secret Key (change this in production!)
# Generate a secure random string: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-generate-secure-random-key

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Upload Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Debug Mode (set to false in production)
DEBUG=true

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000

# Frontend API Base URL (for development)
# In production, nginx proxies /api to backend
VITE_API_BASE=http://localhost:8000

# ============================================
# Docker Compose Overrides
# ============================================
# These are used by docker-compose.yml
# You can override them here if needed

# Database (used in docker-compose)
POSTGRES_DB=zoria
POSTGRES_USER=zoria
POSTGRES_PASSWORD=zoria_password

# ============================================
# Optional: Ollama Configuration (for local models)
# ============================================
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text
# USE_OLLAMA_EMBEDDINGS=false

# ============================================
# Optional: Vector Store Configuration
# ============================================
# VECTOR_STORE_TYPE=pgvector
# EMBEDDING_DIMENSION=1536
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_SEARCH_TOP_K=5
# VECTOR_SIMILARITY_THRESHOLD=0.7

# ============================================
# Production Settings
# ============================================
# For production, set these:
# DEBUG=false
# JWT_SECRET_KEY=<generate-secure-key>
# Use strong database passwords
# Enable HTTPS/SSL
# Set proper CORS origins
